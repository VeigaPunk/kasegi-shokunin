+# Non-file arguments a read-only head requires before its input operands begin: grep's
+# pattern is not an input; every other read-only head takes its operands directly.
+SIGPIPE_REQUIRED_NONFILE_ARGS = {"grep": 1}
+
+
+def sigpipe_input_count(head, argv):
+    """Conservatively count the input operands named by a SIGPIPE'd read-only stage's argv.
+
+    A leading "--" separator is dropped, then the head's required non-file arguments (for
+    grep, the pattern) are skipped; a token starting with "-" that is not "-" itself is an
+    option and not an operand; everything else counts.  Option VALUES are therefore counted
+    as operands and inflate the count — which can only cause a safe stale, never a false
+    exemption.  This is a capability count, not general argument validation.
+    """
+    tokens = list(argv[1:])
+    if tokens and tokens[0] == "--":
+        tokens = tokens[1:]
+    for _ in range(SIGPIPE_REQUIRED_NONFILE_ARGS.get(head, 0)):
+        if tokens:
+            tokens = tokens[1:]
+    return sum(1 for t in tokens if not (t.startswith("-") and t != "-"))
+
