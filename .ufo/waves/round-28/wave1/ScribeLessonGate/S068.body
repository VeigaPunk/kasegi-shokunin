                            href="https://sec.cloudapps.cisco.com/security/center/publicationListing.x">https://sec.cloudapps.cisco.com/security/center/publicationListing.x</a>
                    </p>
                    <p>Cisco Security Tactical Resources: <a
                            href="https://sec.cloudapps.cisco.com/security/center/tacticalresources.x">https://sec.cloudapps.cisco.com/security/center/tacticalresources.x</a>
                    </p>
                    <p>Cisco Worldwide Support Contacts: <a
                            href="https://www.cisco.com/c/en/us/support/web/tsd-cisco-worldwide-contacts.html">https://www.cisco.com/c/en/us/support/web/tsd-cisco-worldwide-contacts.html</a>
                    </p>
                </td>
            </tr>
        </table>
</div>


    <script>
        const sections = document.querySelectorAll("main section[id]");
        const navLinks = document.querySelectorAll("nav a");
        const sideActionBarElement = document.getElementById("sideActionBar");
        const sideActionBarElementOffsetTop = sideActionBarElement.offsetTop;
        const sidebarElement = document.getElementsByClassName("sidebar")[0];
        console.log('sideActionBarElement ', sideActionBarElementOffsetTop);
        const footerElement = document.getElementsByClassName("bottomSection")[0];
        const footerElementOffsetTop = footerElement.offsetTop;
        console.log('sideActionBarElement ', footerElementOffsetTop);
        var messageBody = document.getElementById('sideActionBar');
        messageBody.scrollTop = messageBody.scrollHeight;

        function onScroll() {
            console.log("on scroll", scrollY , footerElementOffsetTop );
            if (scrollY >= sideActionBarElementOffsetTop + 120) {
                sideActionBarElement.style.position = "fixed";
            } else {
                sideActionBarElement.style.position = "initial";
            }

            if (scrollY >= footerElementOffsetTop + 900) {
                sidebarElement.style.height = "300px";
            } else {
                sidebarElement.style.height = "unset";
            }

   if (scrollY >= footerElementOffsetTop + 600 && screen.width > 768 && screen.width < 900) {
                sidebarElement.style.height = "120px";
            }
         
  if (scrollY >= footerElementOffsetTop + 800 && screen.width > 900 && screen.width < 1024) {
                sidebarElement.style.height = "120px";
            }

 if (scrollY >= footerElementOffsetTop + 750 && screen.width > 1583) {
                sidebarElement.style.height = "300px";
            }

            let currentSection = "";
            sections.forEach((section) => {
                const sectionTop = section.offsetTop;
                if (scrollY >= sectionTop - 100) {
                    currentSection = section.getAttribute("id");
                }
            });

            navLinks.forEach((link) => {
                link.classList.remove("active");
                if (link.getAttribute("href") === `#${currentSection}`) {
                    link.classList.add("active");
                }
            });
        }

        window.addEventListener("scroll", onScroll);
    </script>
</body>

</html>

        </div>
</div>




</cdc-template>
