<style>
/* Hide TAC AI / Shepherd UI on narrow viewports (host + proactive popup nodes left by bundle) */
@media (max-width: 767px) {
  shepherd-native-embed,
  #proactivePopupLogin,
  #proactivePopup,
  #signInTAC,
  #closeProactivePopup,
  #shepherdNativeEmbedProactivePopupStyle,
  .shepherd-native-embed-element,
  .csa-proactive-popup {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
}
html.tac-ai-narrow-viewport shepherd-native-embed,
html.tac-ai-narrow-viewport #proactivePopupLogin,
html.tac-ai-narrow-viewport #proactivePopup,
html.tac-ai-narrow-viewport #signInTAC,
html.tac-ai-narrow-viewport #closeProactivePopup,
html.tac-ai-narrow-viewport #shepherdNativeEmbedProactivePopupStyle,
html.tac-ai-narrow-viewport .shepherd-native-embed-element,
html.tac-ai-narrow-viewport .csa-proactive-popup {
  display: none !important;
  visibility: hidden !important;
  pointer-events: none !important;
}
</style>
<script type="module">
const MOBILE_MQ = "(max-width: 767px)";
const mqMobile = window.matchMedia(MOBILE_MQ);

/** Bumped whenever we tear down for mobile; in-flight setup() must abort if stale. */
let tacAiSetupToken = 0;

/**
 * Narrow viewport: CSS media and layout width (avoid visualViewport alone â€” it can
 * disagree with layout width during resize on some browsers).
 */
function isMobileViewport() {
  const mqNarrow = window.matchMedia(MOBILE_MQ).matches;
  const inner = window.innerWidth;
  const client = document.documentElement
    ? document.documentElement.clientWidth
    : inner;
  const layoutW = Math.min(inner, client);
  return mqNarrow || layoutW <= 767;
}

function syncNarrowViewportClass() {
  document.documentElement.classList.toggle(
    "tac-ai-narrow-viewport",
    isMobileViewport()
  );
}

const TAC_AI_SHEPHERD_REMOVE_SELECTORS = [
  "shepherd-native-embed",
  "#proactivePopupLogin",
  "#proactivePopup",
  "#signInTAC",
  "#closeProactivePopup",
  "#shepherdNativeEmbedProactivePopupStyle",
  ".shepherd-native-embed-element",
  ".csa-proactive-popup",
];

/**
 * Removes the custom element and known Cisco Shepherd / proactive popup DOM
 * (the bundle often leaves #proactivePopupLogin etc. after the host is gone).
 */
function removeShepherdEmbed() {
  tacAiSetupToken++;
  TAC_AI_SHEPHERD_REMOVE_SELECTORS.forEach((sel) => {
    try {
      document.querySelectorAll(sel).forEach((el) => {
        el.remove();
      });
    } catch (_) {
      /* ignore invalid selector in very old engines */
    }
  });
}

let tacAiMobileDomObserver = null;

function stopMobileEmbedObserver() {
  if (tacAiMobileDomObserver) {
    tacAiMobileDomObserver.disconnect();
    tacAiMobileDomObserver = null;
  }
}

function nodeMayBeTacAiShepherdUi(el) {
  if (!el || el.nodeType !== 1) {
    return false;
  }
  const id = el.id || "";
  if (
    /^(proactivePopupLogin|proactivePopup|signInTAC|closeProactivePopup|shepherdNativeEmbedProactivePopupStyle)$/.test(
      id
    )
  ) {
    return true;
  }
  if (typeof el.matches !== "function") {
    return false;
  }
  return el.matches(
    "shepherd-native-embed, .shepherd-native-embed-element, .csa-proactive-popup"
  );
}

function nodeTreeMayContainTacAiShepherdUi(root) {
  if (!root || root.nodeType !== 1) {
    return false;
  }
  if (nodeMayBeTacAiShepherdUi(root)) {
    return true;
  }
  if (typeof root.querySelector !== "function") {
    return false;
  }
  return !!root.querySelector(
    "shepherd-native-embed, #proactivePopupLogin, #proactivePopup, .shepherd-native-embed-element, .csa-proactive-popup"
  );
}

/** While narrow, strip any embed the bundle re-attaches to the document. */
function startMobileEmbedObserver() {
  stopMobileEmbedObserver();
  tacAiMobileDomObserver = new MutationObserver((mutations) => {
    if (!isMobileViewport()) {
      stopMobileEmbedObserver();
      return;
    }
    let shouldStrip = false;
    for (let i = 0; i < mutations.length; i++) {
      const added = mutations[i].addedNodes;
      for (let j = 0; j < added.length; j++) {
        if (nodeTreeMayContainTacAiShepherdUi(added[j])) {
          shouldStrip = true;
          break;
        }
      }
      if (shouldStrip) {
        break;
      }
    }
    if (shouldStrip) {
      removeShepherdEmbed();
    }
  });
  tacAiMobileDomObserver.observe(document.documentElement, {
    childList: true,
    subtree: true,
  });
}

function shouldAbortTacAiSetup(tokenAtStart) {
  return tokenAtStart !== tacAiSetupToken || isMobileViewport();
}

/**
 * Keeps class/CSS in sync, tears down embed on mobile, starts embed when wide.
 */
function onTacAiViewportChange() {
  syncNarrowViewportClass();
  if (isMobileViewport()) {
    removeShepherdEmbed();
    startMobileEmbedObserver();
    return;
  }
  stopMobileEmbedObserver();
  startTacAiEmbed();
}

let tacAiBundleInjected = false;

const productConfigurations = {
  name: "Security Advisory Pages",
  environment: "production", // Change this environment to 'production' for using production environment.
  overlay: {
    enabled: true,
  },
  guidedWorkflow: {
    enabled: true,
  },
  hideIcon: true,
};
const deployedBundleUrl =
  "https://inproductexperience.cisco.com/shepherd-native-embed/latest/package/dist/bundle.js";
const pluginParams = {};

async function setupShepherdEmbed() {
  const tokenAtStart = tacAiSetupToken;
  if (shouldAbortTacAiSetup(tokenAtStart)) {
    return;
  }

  await customElements.whenDefined("shepherd-native-embed");
  if (shouldAbortTacAiSetup(tokenAtStart)) {
    return;
  }

  if (document.querySelector("shepherd-native-embed")) {
    console.log("Plugin is already present.");
    return;
  }

  if (shouldAbortTacAiSetup(tokenAtStart)) {
    return;
  }

  const shepherdElement = document.createElement("shepherd-native-embed");
  shepherdElement.setAttribute("data-options", JSON.stringify(pluginParams));
  document.body.appendChild(shepherdElement);

  if (shouldAbortTacAiSetup(tokenAtStart)) {
    shepherdElement.remove();
    return;
  }

  /**
   * Checks if the document's published date from the DOM is after a given date.
   *
   * This function extracts the published date from the page's DOM element
   * (#ud-published .divLabelContent), compares it with the provided date,
   * and returns true if the published date is more recent.
   *
   * @param {string} givenDate - The date to compare against (in a format parseable by Date constructor, e.g., 'YYYY-MM-DD')
   * @returns {boolean} - Returns true if published date is after the given date, false otherwise
   */
  function checkPublishedDate(givenDate) {
    try {
      const publishedElement = document.querySelector(
        "#ud-published .divLabelContent"
      );
      if (!publishedElement) {
        console.warn("Published date element not found");
        return false;
      }

      const publishedDateString = publishedElement.textContent.trim();
      if (!publishedDateString) {
        console.warn("Published date string is empty");
        return false;
      }

      const publishedDate = new Date(publishedDateString);
      const comparisonDate = new Date(givenDate);

      if (isNaN(publishedDate.getTime()) || isNaN(comparisonDate.getTime())) {
        console.error("Invalid date format detected");
        return false;
      }

      return publishedDate > comparisonDate;
    } catch (error) {
      console.error("Error comparing dates:", error.message);
      return false;
    }
  }

  /**
   * Inserts proactivepopup for unauthenticated user
   */
  const handleUnauthenticatedCallback = async () => {
    const pageTitleElement = document.querySelector(".pageHeadTitle");
    const pageTitle = pageTitleElement
      ? pageTitleElement.textContent.trim()
      : "";

    if (pageTitle === "Cisco IOS XE Software Hardening Guide") {
      await shepherdElement.initiateProactivePopup();
    } else if (checkPublishedDate("2025-06-30")) {
      await shepherdElement.initiateProactivePopup();
    }
  };

  if (typeof shepherdElement.setup === "function") {
    await shepherdElement.setup(
      productConfigurations,
      null,
      handleUnauthenticatedCallback
    );
  }

  if (shouldAbortTacAiSetup(tokenAtStart)) {
    shepherdElement.remove();
  }
}

function startTacAiEmbed() {
  if (isMobileViewport()) {
    return;
  }
  if (!tacAiBundleInjected) {
    tacAiBundleInjected = true;
    const script = document.createElement("script");
    script.src = deployedBundleUrl;
    script.charset = "utf-8";
    script.onload = () => {
      console.log("Bundle loaded successfully.");
      setupShepherdEmbed().catch((error) => {
        console.error("Error setting up shepherd embed:", error);
      });
    };
    document.head.appendChild(script);
    return;
  }

  setupShepherdEmbed().catch((error) => {
    console.error("Error setting up shepherd embed:", error);
  });
}

let tacAiResizeTimer;

/** Instant teardown on shrink so the widget does not linger behind debounce. */
function applyTacAiViewportImmediate() {
  syncNarrowViewportClass();
  if (isMobileViewport()) {
    removeShepherdEmbed();
    startMobileEmbedObserver();
    requestAnimationFrame(() => {
      if (isMobileViewport()) {
        removeShepherdEmbed();
      }
    });
  } else {
    stopMobileEmbedObserver();
  }
}

function scheduleTacAiViewportDebounce() {
  clearTimeout(tacAiResizeTimer);
  tacAiResizeTimer = setTimeout(onTacAiViewportChange, 100);
}

window.addEventListener("resize", () => {
  applyTacAiViewportImmediate();
  scheduleTacAiViewportDebounce();
});

if (typeof ResizeObserver !== "undefined" && document.documentElement) {
  try {
    const tacAiLayoutRo = new ResizeObserver(() => {
      applyTacAiViewportImmediate();
      scheduleTacAiViewportDebounce();
    });
    tacAiLayoutRo.observe(document.documentElement);
  } catch (_) {
    /* ignore */
  }
}

if (typeof mqMobile.addEventListener === "function") {
  mqMobile.addEventListener("change", onTacAiViewportChange);
} else if (typeof mqMobile.addListener === "function") {
  mqMobile.addListener(onTacAiViewportChange);
}

onTacAiViewportChange();
</script>


