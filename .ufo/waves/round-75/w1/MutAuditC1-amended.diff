+def has_restoration_recheck(path):
+    """True when the entry carries a `restoration-recheck:` header line (never executed)."""
+    with open(path, encoding="utf-8", errors="replace") as fh:
+        for line in fh:
+            if line.startswith("restoration-recheck:"):
+                return True
+    return False
+
